---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SocialLinks from '@/components/SocialLinks.astro';
import { contacts } from '@/utils/links';
---
<BaseLayout title="Контакты | Well Art" description="Адрес, телефон, WhatsApp, Telegram и маршрут в мебельный салон Well Art в Махачкале.">
  <div class="container">
    <header class="page-hero contact-hero">
      <p class="eyebrow">Контакты</p>
      <h1>Приезжайте смотреть вживую</h1>
      <p>Сопоставьте оттенки, фактуры и пропорции мебели в пространстве салона.</p>
    </header>
  </div>
  <section class="contact-grid">
    <div class="contact-photo"><img src="https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?auto=format&fit=crop&w=1500&q=86" alt="Интерьер гостиной с тёплым светом" width="1400" height="1200" /></div>
    <div class="contact-details">
      <div class="contact-block">
        <p class="eyebrow">Адрес</p>
        <h2>{contacts.address}</h2>
        <p>{contacts.floor}</p>
        <a class="button" href={contacts.route} target="_blank" rel="noreferrer">Открыть маршрут в 2ГИС ↗</a>
      </div>
      <div class="contact-lines">
        <div><span>Телефон</span><a href={contacts.phoneLink}>{contacts.phoneDisplay}</a></div>
        <div><span>Написать</span><SocialLinks label="Написать Well Art" /></div>
        <div><span>Время</span><p>{contacts.hours}</p></div>
        <div><span>Все ссылки</span><p><a href={contacts.taplink} target="_blank" rel="noreferrer">Открыть Taplink ↗</a></p></div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-hero { max-width: 1000px; }
  .contact-grid { display: grid; grid-template-columns: 1.08fr .92fr; background: var(--paper); }
  .contact-photo { min-height: 900px; }
  .contact-photo img { width: 100%; height: 100%; object-fit: cover; }
  .contact-details { display: flex; padding: clamp(56px, 7vw, 110px); flex-direction: column; justify-content: space-between; }
  .contact-block h2 { max-width: 560px; margin-bottom: 14px; font-size: clamp(2.3rem, 3.8vw, 4.2rem); }
  .contact-block > p:not(.eyebrow) { color: var(--muted); }
  .contact-block .button { margin-top: 28px; }
  .contact-lines { margin-top: 80px; border-top: 1px solid var(--taupe); }
  .contact-lines > div { display: grid; grid-template-columns: 150px 1fr; gap: 20px; padding: 20px 0; border-bottom: 1px solid var(--taupe); }
  .contact-lines span { color: var(--muted); font-size: .78rem; }
  .contact-lines p { display: flex; margin: 0; gap: 18px; }
  .contact-lines small { color: var(--muted); }
  @media (max-width: 840px) {
    .contact-grid { grid-template-columns: 1fr; }
    .contact-photo { min-height: 520px; }
    .contact-details { padding: 64px 20px; }
  }
  @media (max-width: 480px) { .contact-lines > div { grid-template-columns: 1fr; gap: 4px; } }
</style>
