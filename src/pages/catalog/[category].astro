---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProductCard from '@/components/ProductCard.astro';
import ContactStrip from '@/components/ContactStrip.astro';
import { categories, productsInCategory } from '@/data/catalog';
import { whatsappUrl } from '@/utils/links';

export function getStaticPaths() {
  return categories.map((category) => ({ params: { category: category.slug }, props: { category } }));
}
const { category } = Astro.props;
const items = productsInCategory(category.slug);
const categoryMessage = `Здравствуйте! Интересует раздел «${category.shortName}». Подскажите, что сейчас есть в наличии.`;
const categoryWhatsapp = whatsappUrl(categoryMessage);
const categoryUrl = new URL(`/catalog/${category.slug}`, Astro.site);
const categorySchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: category.name,
  numberOfItems: items.length,
  itemListElement: items.map((product, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: product.name,
    url: new URL(`/product/${product.slug}`, Astro.site).toString(),
  })),
};
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: new URL('/', Astro.site).toString() },
    { '@type': 'ListItem', position: 2, name: 'Каталог', item: new URL('/catalog', Astro.site).toString() },
    { '@type': 'ListItem', position: 3, name: category.name, item: categoryUrl.toString() },
  ],
};
---
<BaseLayout title={`${category.name} | Well Art`} description={`${category.description} Мебельный салон Well Art в Махачкале.`} image={category.imageJpeg} imageAlt={category.description} structuredData={[categorySchema, breadcrumbSchema]}>
  <div class="container">
    <header class="page-hero">
      <nav class="breadcrumbs" aria-label="Хлебные крошки"><a href="/">Главная</a><span>/</span><a href="/catalog">Каталог</a><span>/</span><span aria-current="page">{category.shortName}</span></nav>
      <p class="eyebrow">Категория</p>
      <h1>{category.name}</h1>
      <p>{category.description}</p>
    </header>
    <div class="category-image"><picture><source type="image/avif" srcset={category.imageAvif} /><img src={category.imageJpeg} alt={category.description} width="1000" height="1500" style={`object-position:${category.position}`} /></picture></div>
    <section class="category-products" aria-label={`Товары: ${category.name}`}>
      <p class="category-count">{items.length} {items.length === 1 ? 'позиция' : 'позиций'}</p>
      {items.length > 0 ? (
        <div class="product-grid">{items.map((product) => <ProductCard product={product} />)}</div>
      ) : (
        <div class="category-empty">
          <h2>Подборка обновляется</h2>
          <p>Покажем актуальные модели и цены в WhatsApp.</p>
          <a class="button" href={categoryWhatsapp} target="_blank" rel="noreferrer">Уточнить наличие</a>
        </div>
      )}
    </section>
  </div>
  <ContactStrip />
</BaseLayout>

<style>
  .category-image { height: clamp(360px, 55vw, 700px); margin-bottom: clamp(72px, 9vw, 130px); }
  .category-image picture, .category-image img { display: block; width: 100%; height: 100%; }
  .category-image img { object-fit: cover; }
  .category-products { padding-bottom: clamp(96px, 11vw, 160px); }
  .category-count { margin-bottom: 28px; padding-bottom: 18px; border-bottom: 1px solid var(--taupe); color: var(--muted); font-size: .8rem; }
  .category-empty { max-width: 620px; padding: clamp(44px, 6vw, 80px) 0; }
  .category-empty h2 { margin-bottom: 16px; }
  .category-empty p { margin-bottom: 28px; color: var(--muted); }
</style>
