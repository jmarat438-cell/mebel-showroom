---
import BaseLayout from '@/layouts/BaseLayout.astro';
---
<BaseLayout title="Страница не найдена" description="Такой страницы нет.">
  <section class="not-found">
    <div class="not-found__image"><img src="https://images.unsplash.com/photo-1618220179428-22790b461013?auto=format&fit=crop&w=1400&q=84" alt="Кресло в спокойном интерьере" width="1200" height="1400" /></div>
    <div class="not-found__copy">
      <p class="eyebrow">Ошибка 404</p>
      <h1>Этого предмета здесь нет</h1>
      <p>Вернёмся в каталог: там можно продолжить знакомство с коллекцией.</p>
      <a class="button" href="/catalog">Перейти в каталог</a>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found { display: grid; min-height: calc(100svh - 88px); grid-template-columns: 1fr 1fr; background: var(--paper); }
  .not-found__image img { width: 100%; height: 100%; object-fit: cover; }
  .not-found__copy { display: flex; padding: clamp(48px, 8vw, 130px); flex-direction: column; align-items: flex-start; justify-content: center; }
  .not-found h1 { margin-bottom: 28px; font-size: clamp(3rem, 5.5vw, 6rem); }
  .not-found__copy > p:not(.eyebrow) { max-width: 44ch; margin-bottom: 36px; color: var(--muted); }
  @media (max-width: 720px) { .not-found { grid-template-columns: 1fr; }.not-found__image { min-height: 45svh; }.not-found__copy { padding: 64px 20px 90px; } }
</style>
