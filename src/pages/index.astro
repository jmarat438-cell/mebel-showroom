---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProductCard from '@/components/ProductCard.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import ContactStrip from '@/components/ContactStrip.astro';
import { categories, products } from '@/data/catalog';
import { contacts } from '@/utils/links';

const featured = products.filter((item) => item.featured && item.price).slice(0, 3);
---
<BaseLayout title="Well Art | Мебельный салон в Махачкале" description="Мебельный салон Well Art в Махачкале. Выразительная мебель в наличии и под заказ." darkHeader>
  <section class="home-hero" aria-labelledby="hero-title">
    <div class="home-hero__content">
      <h1 id="hero-title">Интерьер<br />с характером</h1>
      <p>{contacts.tagline} Модели в наличии и под заказ.</p>
      <div class="button-row">
        <a class="button button--light" href="/catalog">Смотреть каталог</a>
        <a class="hero-link" href={contacts.whatsapp} target="_blank" rel="noreferrer">Написать в WhatsApp ↗</a>
      </div>
    </div>
    <picture class="home-hero__picture">
      <source type="image/avif" srcset="/media/wellart/hero-panel-768.avif 768w, /media/wellart/hero-panel-1280.avif 1280w, /media/wellart/hero-panel-1708.avif 1708w" sizes="(max-width: 800px) 100vw, 45vw" />
      <img class="home-hero__image" src="/media/wellart/hero-panel-1280.jpg" srcset="/media/wellart/hero-panel-768.jpg 768w, /media/wellart/hero-panel-1280.jpg 1280w, /media/wellart/hero-panel-1708.jpg 1708w" sizes="(max-width: 800px) 100vw, 45vw" alt="Интерьер шоурума Well Art с модульными диванами и журнальными столиками" width="1708" height="2560" fetchpriority="high" />
    </picture>
  </section>

  <section id="categories" class="section categories-section container">
    <SectionHeading eyebrow="Коллекции" title="Соберите пространство целиком" text="От мягкой группы до света: начните с комнаты или предмета, который задаёт настроение." />
    <div class="category-mosaic">
      {categories.map((category, index) => (
        <a class:list={['category-tile', `category-tile--${index + 1}`]} href={`/catalog/${category.slug}`} data-reveal>
          <picture>
            <source type="image/avif" srcset={category.imageAvif} />
            <img src={category.imageJpeg} alt={category.description} width="1000" height="1500" loading={index < 2 ? 'eager' : 'lazy'} style={`object-position:${category.position}`} />
          </picture>
          <span class="category-number">0{index + 1}</span>
          <h3>{category.shortName}</h3>
          <span class="category-arrow" aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
  </section>

  <section class="section featured-section">
    <div class="container">
      <SectionHeading eyebrow="Из Telegram Well Art" title="Первые позиции с актуальными ценами" text="Три предмета из последних публикаций салона. Наличие и итоговую стоимость лучше подтвердить перед заказом." />
      <div class="product-grid">
        {featured.map((product) => <ProductCard product={product} />)}
      </div>
      <div class="center-action"><a class="button button--outline" href="/catalog">Весь каталог</a></div>
    </div>
  </section>

  <section id="about" class="showroom-story">
    <div class="story-image story-image--main" data-reveal>
      <picture><source type="image/avif" srcset="/media/wellart/story-main.avif" /><img src="/media/wellart/story-main.jpg" alt="Пространство шоурума Well Art с модульным диваном" width="1200" height="1799" loading="lazy" /></picture>
    </div>
    <div class="story-copy" data-reveal>
      <p class="eyebrow eyebrow--light">О салоне</p>
      <h2>Интерьер начинается с ощущения</h2>
      <div class="story-copy__body">
        <p>Мы не рассматриваем мебель отдельно от пространства. В Well Art диваны, столы, свет и декор собраны в интерьерные композиции, чтобы можно было почувствовать их масштаб, цвет и характер рядом друг с другом.</p>
        <p>Салон задуман как место для спокойного выбора. Здесь можно пройти пять этажей, присмотреться к материалам, обсудить будущий интерьер и сделать паузу за кофе.</p>
      </div>
      <a class="text-link" href="/contacts">Как нас найти</a>
    </div>
    <div class="story-image story-image--detail" data-reveal>
      <picture><source type="image/avif" srcset="/media/wellart/story-detail.avif" /><img src="/media/wellart/story-detail.jpg" alt="Модульный диван и журнальные столики в шоуруме Well Art" width="800" height="1000" loading="lazy" /></picture>
    </div>
  </section>

  <section id="delivery" class="visit-story section">
    <div class="visit-story__inner container">
      <div class="visit-story__copy" data-reveal>
        <h2>Сначала увидеть.<br />Потом выбрать.</h2>
        <p class="visit-story__lead">Пять этажей Well Art собраны как разные жилые пространства. Здесь мебель можно оценить не по отдельной карточке, а в окружении света, текстиля и декора.</p>
        <p>Сравните посадку, фактуры и оттенки вживую. Модели доступны в наличии и под заказ, а условия доставки менеджер рассчитает для вашего адреса.</p>
        <div class="visit-story__meta">
          <p><strong>Ежедневно</strong><br />с 10:00 до 19:00</p>
          <a class="text-link" href="/contacts">Спланировать визит</a>
        </div>
      </div>
      <div class="visit-story__image" data-reveal>
        <picture><source type="image/avif" srcset="/media/wellart/visit-story.avif" /><img src="/media/wellart/visit-story.jpg" alt="Диван, журнальные столики и настенное панно в шоуруме Well Art" width="1000" height="1250" loading="lazy" /></picture>
      </div>
    </div>
  </section>

  <ContactStrip />
</BaseLayout>

<style>
  .home-hero { display: grid; min-height: 100dvh; overflow: hidden; color: var(--paper); background: var(--ink); grid-template-columns: minmax(0, 1.1fr) minmax(0, .9fr); }
  .home-hero__picture, .home-hero__image { display: block; width: 100%; height: 100%; }
  .home-hero__picture { min-height: 100dvh; overflow: hidden; }
  .home-hero__image { object-fit: cover; object-position: center; animation: hero-in 1.4s var(--ease-out) both; }
  .home-hero__content { position: relative; z-index: 1; display: flex; min-height: 100dvh; padding: clamp(128px, 15vh, 190px) clamp(48px, 6vw, 96px) 68px max(48px, calc((100vw - 1360px) / 2)); flex-direction: column; align-items: flex-start; justify-content: center; animation: content-in 1s .18s var(--ease-out) both; }
  .home-hero h1 { max-width: 850px; margin-bottom: 28px; }
  .home-hero__content > p { width: 100%; max-width: 46ch; margin-bottom: 38px; color: color-mix(in oklch, var(--paper), transparent 14%); font-size: clamp(1rem, 1.3vw, 1.16rem); }
  .hero-link { display: inline-flex; min-height: 52px; align-items: center; border-bottom: 1px solid currentColor; font-weight: 600; }
  @keyframes hero-in { from { transform: scale(1.035); filter: brightness(.8); } to { transform: scale(1); filter: brightness(1); } }
  @keyframes content-in { from { opacity: 0; transform: translateY(24px); } to { opacity: 1; transform: none; } }
  .category-mosaic { display: grid; grid-template-columns: repeat(12, 1fr); gap: 24px; align-items: start; }
  .category-tile { position: relative; display: block; overflow: hidden; color: var(--paper); }
  .category-tile::after { position: absolute; inset: 0; background: linear-gradient(0deg, color-mix(in oklch, var(--ink), transparent 15%), transparent 55%); content: ''; }
  .category-tile picture { display: block; width: 100%; height: 100%; }
  .category-tile img { width: 100%; height: 100%; object-fit: cover; transition: transform .7s var(--ease-out), filter .4s; }
  .category-tile:hover img { transform: scale(1.03); filter: brightness(.88); }
  .category-tile--1 { grid-column: 1 / 8; aspect-ratio: 1.32 / 1; }
  .category-tile--2 { grid-column: 9 / 13; margin-top: 112px; aspect-ratio: .78 / 1; }
  .category-tile--3 { grid-column: 1 / 5; margin-top: 24px; aspect-ratio: .82 / 1; }
  .category-tile--4 { grid-column: 6 / 13; margin-top: 84px; aspect-ratio: 1.36 / 1; }
  .category-tile--5 { grid-column: 2 / 8; margin-top: 24px; aspect-ratio: 1.15 / 1; }
  .category-tile--6 { grid-column: 9 / 13; margin-top: 104px; aspect-ratio: .82 / 1; }
  .category-tile h3 { position: absolute; z-index: 2; right: 22px; bottom: 20px; left: 22px; margin: 0; padding-right: 42px; font-family: 'Prata', Georgia, serif; font-size: clamp(1.45rem, 2.5vw, 2.4rem); }
  .category-number { position: absolute; z-index: 2; top: 20px; left: 22px; font-size: .72rem; letter-spacing: .08em; }
  .category-arrow { position: absolute; z-index: 2; right: 22px; bottom: 23px; font-size: 1.25rem; }
  .featured-section { background: var(--paper); }
  .center-action { display: flex; justify-content: center; margin-top: 72px; }
  .showroom-story { display: grid; min-height: 1000px; padding: clamp(72px, 10vw, 150px) max(24px, calc((100vw - 1360px) / 2)); scroll-margin-top: 84px; grid-template-columns: 1.22fr .78fr; grid-template-rows: 1fr auto; gap: 72px clamp(40px, 7vw, 120px); background: var(--ink); color: var(--paper); }
  .story-image picture, .story-image img { display: block; width: 100%; height: 100%; }
  .story-image img { object-fit: cover; }
  .story-image--main { min-height: 700px; grid-row: 1 / 3; }
  .story-copy { align-self: end; }
  .story-copy h2 { margin-bottom: 26px; }
  .story-copy__body { display: grid; max-width: 56ch; gap: 14px; color: color-mix(in oklch, var(--paper), transparent 28%); }
  .story-copy__body p { margin: 0; }
  .story-copy .text-link { margin-top: 28px; }
  .story-image--detail { width: 62%; aspect-ratio: .8 / 1; justify-self: end; }
  .visit-story { scroll-margin-top: 84px; background: var(--taupe); }
  .visit-story__inner { display: grid; grid-template-columns: minmax(0, .9fr) minmax(380px, .72fr); gap: clamp(56px, 9vw, 150px); align-items: center; }
  .visit-story__copy { max-width: 680px; }
  .visit-story__copy h2 { margin-bottom: 34px; }
  .visit-story__copy > p { max-width: 57ch; color: color-mix(in oklch, var(--ink), transparent 24%); }
  .visit-story__lead { font-size: clamp(1.08rem, 1.35vw, 1.28rem); }
  .visit-story__meta { display: flex; gap: 32px; align-items: flex-end; justify-content: space-between; margin-top: 48px; padding-top: 24px; border-top: 1px solid color-mix(in oklch, var(--ink), transparent 70%); }
  .visit-story__meta p { margin: 0; color: var(--muted); }
  .visit-story__meta strong { color: var(--ink); font-weight: 600; }
  .visit-story__image, .visit-story__image picture, .visit-story__image img { display: block; width: 100%; }
  .visit-story__image { aspect-ratio: 4 / 5; overflow: hidden; }
  .visit-story__image img { height: 100%; object-fit: cover; }
  @media (max-width: 800px) {
    .home-hero { min-height: 100dvh; grid-template-columns: 1fr; grid-template-rows: 42dvh auto; }
    .home-hero__picture { min-height: 0; grid-row: 1; }
    .home-hero__content { min-height: 58dvh; padding: 42px 20px 48px; grid-row: 2; justify-content: center; }
    .home-hero h1 { max-width: 100%; font-size: clamp(2.75rem, 12vw, 3.35rem); }
    .home-hero .button-row { display: grid; width: 100%; gap: 14px; }
    .home-hero .button, .home-hero .hero-link { width: 100%; justify-content: center; }
    .category-mosaic { gap: 12px; }
    .category-tile--1, .category-tile--2, .category-tile--3, .category-tile--4, .category-tile--5, .category-tile--6 { grid-column: span 6; margin-top: 0; aspect-ratio: .78 / 1; }
    .category-tile h3 { right: 12px; bottom: 13px; left: 12px; padding: 0; font-size: 1.15rem; }
    .category-number { top: 12px; left: 12px; }
    .category-arrow { display: none; }
    .showroom-story { min-height: 0; grid-template-columns: 1fr; grid-template-rows: auto; gap: 56px; }
    .story-image--main { min-height: 520px; grid-row: auto; }
    .story-image--detail { width: 70%; aspect-ratio: .8 / 1; }
    .visit-story__inner { grid-template-columns: 1fr; gap: 54px; }
    .visit-story__image { width: 88%; justify-self: end; }
    .visit-story__meta { align-items: flex-start; flex-direction: column; }
  }
  @media (prefers-reduced-motion: reduce) { .home-hero__image, .home-hero__content { animation: none; } }
</style>
