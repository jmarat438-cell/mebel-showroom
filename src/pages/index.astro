---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProductCard from '@/components/ProductCard.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import ContactStrip from '@/components/ContactStrip.astro';
import { categories, products } from '@/data/catalog';
import { contacts } from '@/utils/links';

const featured = products.filter((item) => item.featured && item.price).slice(0, 3);
---
<BaseLayout title="Well Art | Мебельный салон в Махачкале" description="Мебельный салон Well Art в Махачкале. Выразительная мебель в наличии и под заказ." darkHeader>
  <section class="home-hero" aria-labelledby="hero-title">
    <img class="home-hero__image" src="https://images.unsplash.com/photo-1600210492486-724fe5c67fb0?auto=format&fit=crop&w=2200&q=88" alt="Гостиная с мягкой мебелью, деревянными деталями и тёплым светом" width="2200" height="1467" />
    <div class="home-hero__shade"></div>
    <div class="home-hero__content">
      <h1 id="hero-title">Интерьер<br />с характером</h1>
      <p>{contacts.tagline} Модели в наличии и под заказ.</p>
      <div class="button-row">
        <a class="button button--light" href="/catalog">Смотреть каталог</a>
        <a class="hero-link" href={contacts.whatsapp} target="_blank" rel="noreferrer">Написать в WhatsApp ↗</a>
      </div>
    </div>
  </section>

  <section id="categories" class="section categories-section container">
    <SectionHeading eyebrow="Коллекции" title="Соберите пространство целиком" text="От мягкой группы до света: начните с комнаты или предмета, который задаёт настроение." />
    <div class="category-mosaic">
      {categories.map((category, index) => (
        <a class:list={['category-tile', `category-tile--${index + 1}`]} href={`/catalog/${category.slug}`} data-reveal>
          <img src={category.image} alt={category.description} width="1000" height="1200" loading={index < 2 ? 'eager' : 'lazy'} style={`object-position:${category.position}`} />
          <span class="category-number">0{index + 1}</span>
          <h3>{category.shortName}</h3>
          <span class="category-arrow" aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
  </section>

  <section class="section featured-section">
    <div class="container">
      <SectionHeading eyebrow="Из Telegram Well Art" title="Первые позиции с актуальными ценами" text="Три предмета из последних публикаций салона. Наличие и итоговую стоимость лучше подтвердить перед заказом." />
      <div class="product-grid">
        {featured.map((product, index) => <ProductCard product={product} eager={index < 3} />)}
      </div>
      <div class="center-action"><a class="button button--outline" href="/catalog">Весь каталог</a></div>
    </div>
  </section>

  <section id="about" class="showroom-story">
    <div class="story-image story-image--main" data-reveal>
      <img src="https://images.unsplash.com/photo-1618221195710-dd6b41faaea6?auto=format&fit=crop&w=1500&q=86" alt="Светлая гостиная с диваном и предметами декора" width="1300" height="1050" loading="lazy" />
    </div>
    <div class="story-copy" data-reveal>
      <p class="eyebrow eyebrow--light">О салоне</p>
      <h2>Увидеть. Коснуться. Сопоставить.</h2>
      <p>В шоуруме Well Art мебель можно рассмотреть в масштабе интерьера, почувствовать фактуру и спокойно обсудить подходящие модели.</p>
      <a class="text-link" href="/contacts">Как нас найти</a>
    </div>
    <div class="story-image story-image--detail" data-reveal>
      <img src="https://images.unsplash.com/photo-1616486338812-3dadae4b4ace?auto=format&fit=crop&w=900&q=86" alt="Деталь мягкого кресла и деревянного столика" width="900" height="1150" loading="lazy" />
    </div>
  </section>

  <section id="delivery" class="values-section section">
    <div class="container">
      <p class="eyebrow">Well Art</p>
      <div class="value-list">
        <p><span>01</span>Мебельный салон</p>
        <p><span>02</span>Мебель в наличии и под заказ</p>
        <p><span>03</span>Доставка</p>
        <p><span>04</span>Ежедневно с 10:00 до 19:00</p>
      </div>
      <p class="values-note">Условия доставки менеджер уточнит для вашего адреса.</p>
    </div>
  </section>

  <ContactStrip />
</BaseLayout>

<style>
  .home-hero { position: relative; min-height: 100dvh; overflow: hidden; color: var(--paper); background: var(--ink); }
  .home-hero__image, .home-hero__shade { position: absolute; inset: 0; width: 100%; height: 100%; }
  .home-hero__image { object-fit: cover; object-position: 50% 52%; animation: hero-in 1.4s var(--ease-out) both; }
  .home-hero__shade { background: linear-gradient(90deg, color-mix(in oklch, var(--ink), transparent 12%) 0%, color-mix(in oklch, var(--ink), transparent 55%) 54%, transparent 84%), linear-gradient(0deg, color-mix(in oklch, var(--ink), transparent 35%), transparent 50%); }
  .home-hero__content { position: relative; z-index: 1; display: flex; width: var(--page); min-height: 100dvh; margin-inline: auto; padding: clamp(128px, 15vh, 190px) 0 68px; flex-direction: column; align-items: flex-start; justify-content: center; animation: content-in 1s .18s var(--ease-out) both; }
  .home-hero h1 { max-width: 850px; margin-bottom: 28px; }
  .home-hero__content > p { max-width: 46ch; margin-bottom: 38px; color: color-mix(in oklch, var(--paper), transparent 14%); font-size: clamp(1rem, 1.3vw, 1.16rem); }
  .hero-link { display: inline-flex; min-height: 52px; align-items: center; border-bottom: 1px solid currentColor; font-weight: 600; }
  @keyframes hero-in { from { transform: scale(1.035); filter: brightness(.8); } to { transform: scale(1); filter: brightness(1); } }
  @keyframes content-in { from { opacity: 0; transform: translateY(24px); } to { opacity: 1; transform: none; } }
  .category-mosaic { display: grid; grid-template-columns: repeat(12, 1fr); gap: 24px; align-items: start; }
  .category-tile { position: relative; display: block; overflow: hidden; color: var(--paper); }
  .category-tile::after { position: absolute; inset: 0; background: linear-gradient(0deg, color-mix(in oklch, var(--ink), transparent 15%), transparent 55%); content: ''; }
  .category-tile img { width: 100%; height: 100%; object-fit: cover; transition: transform .7s var(--ease-out), filter .4s; }
  .category-tile:hover img { transform: scale(1.03); filter: brightness(.88); }
  .category-tile--1 { grid-column: 1 / 8; aspect-ratio: 1.32 / 1; }
  .category-tile--2 { grid-column: 9 / 13; margin-top: 112px; aspect-ratio: .78 / 1; }
  .category-tile--3 { grid-column: 1 / 5; margin-top: 24px; aspect-ratio: .82 / 1; }
  .category-tile--4 { grid-column: 6 / 13; margin-top: 84px; aspect-ratio: 1.36 / 1; }
  .category-tile--5 { grid-column: 2 / 8; margin-top: 24px; aspect-ratio: 1.15 / 1; }
  .category-tile--6 { grid-column: 9 / 13; margin-top: 104px; aspect-ratio: .82 / 1; }
  .category-tile h3 { position: absolute; z-index: 2; right: 22px; bottom: 20px; left: 22px; margin: 0; padding-right: 42px; font-family: 'Prata', Georgia, serif; font-size: clamp(1.45rem, 2.5vw, 2.4rem); }
  .category-number { position: absolute; z-index: 2; top: 20px; left: 22px; font-size: .72rem; letter-spacing: .08em; }
  .category-arrow { position: absolute; z-index: 2; right: 22px; bottom: 23px; font-size: 1.25rem; }
  .featured-section { background: var(--paper); }
  .center-action { display: flex; justify-content: center; margin-top: 72px; }
  .showroom-story { display: grid; min-height: 1000px; padding: clamp(72px, 10vw, 150px) max(24px, calc((100vw - 1360px) / 2)); grid-template-columns: 1.22fr .78fr; grid-template-rows: 1fr auto; gap: 72px clamp(40px, 7vw, 120px); background: var(--ink); color: var(--paper); }
  .story-image img { width: 100%; height: 100%; object-fit: cover; }
  .story-image--main { min-height: 700px; grid-row: 1 / 3; }
  .story-copy { align-self: end; }
  .story-copy h2 { margin-bottom: 26px; }
  .story-copy > p:not(.eyebrow) { max-width: 45ch; color: color-mix(in oklch, var(--paper), transparent 32%); }
  .story-copy .text-link { margin-top: 16px; }
  .story-image--detail { width: 62%; aspect-ratio: .8 / 1; justify-self: end; }
  .values-section { background: var(--taupe); }
  .value-list { border-top: 1px solid color-mix(in oklch, var(--ink), transparent 70%); }
  .value-list p { display: grid; margin: 0; padding: 24px 0; border-bottom: 1px solid color-mix(in oklch, var(--ink), transparent 70%); grid-template-columns: 90px 1fr; font-family: 'Prata', Georgia, serif; font-size: clamp(1.4rem, 3vw, 3rem); line-height: 1.2; }
  .value-list span { padding-top: 8px; font-family: 'Manrope', sans-serif; font-size: .7rem; }
  .values-note { max-width: 48ch; margin: 28px 0 0 90px; color: var(--muted); }
  @media (max-width: 800px) {
    .home-hero__shade { background: linear-gradient(0deg, color-mix(in oklch, var(--ink), transparent 7%) 0%, transparent 80%); }
    .home-hero__content { justify-content: flex-end; padding-bottom: 92px; }
    .category-mosaic { gap: 12px; }
    .category-tile--1, .category-tile--2, .category-tile--3, .category-tile--4, .category-tile--5, .category-tile--6 { grid-column: span 6; margin-top: 0; aspect-ratio: .78 / 1; }
    .category-tile h3 { right: 12px; bottom: 13px; left: 12px; padding: 0; font-size: 1.15rem; }
    .category-number { top: 12px; left: 12px; }
    .category-arrow { display: none; }
    .showroom-story { min-height: 0; grid-template-columns: 1fr; grid-template-rows: auto; gap: 56px; }
    .story-image--main { min-height: 520px; grid-row: auto; }
    .story-image--detail { width: 70%; aspect-ratio: .8 / 1; }
  }
  @media (prefers-reduced-motion: reduce) { .home-hero__image, .home-hero__content { animation: none; } }
</style>
