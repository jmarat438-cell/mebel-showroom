---
import { contacts } from '@/utils/links';
---
<section class="contact-strip" aria-labelledby="visit-heading">
  <div class="contact-strip__content" data-reveal>
    <p class="eyebrow eyebrow--light">Шоурум в Махачкале</p>
    <h2 id="visit-heading">Лучше один раз<br />увидеть вживую</h2>
    <p>{contacts.address}. 1–3 этажи.</p>
    <div class="button-row">
      <a class="button button--light" href={contacts.route} target="_blank" rel="noreferrer">Построить маршрут ↗</a>
      <a class="text-link text-link--light" href={contacts.phoneLink}>Позвонить</a>
    </div>
  </div>
  <div class="contact-strip__image">
    <img src="https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?auto=format&fit=crop&w=1400&q=84" alt="Просторная гостиная с мягкой мебелью и тёплым светом" width="1200" height="900" loading="lazy" />
  </div>
</section>
