---
import { contacts } from '@/utils/links';
---
<section class="contact-strip" aria-labelledby="visit-heading">
  <div class="contact-strip__content" data-reveal>
    <p class="eyebrow eyebrow--light">Шоурум Well Art</p>
    <h2 id="visit-heading">Лучше один раз<br />увидеть вживую</h2>
    <p>{contacts.address} {contacts.floor}.</p>
    <div class="button-row">
      <a class="button button--light" href={contacts.route} target="_blank" rel="noopener noreferrer">Построить маршрут ↗</a>
      <a class="text-link text-link--light" href={contacts.phoneLink}>Позвонить</a>
    </div>
  </div>
  <div class="contact-strip__image">
    <picture><source type="image/avif" srcset="/media/wellart/contact-strip.avif" /><img src="/media/wellart/contact-strip.jpg" alt="Интерьерная экспозиция шоурума Well Art" width="1400" height="933" loading="lazy" /></picture>
  </div>
</section>
