---
import { contacts } from '@/utils/links';
import SocialLinks from '@/components/SocialLinks.astro';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="footer-main">
    <div class="footer-brand">
      <a class="footer-wordmark" href="/" aria-label="Well Art, на главную">
        <img
          src="/brand/wellart-logo.png"
          alt=""
          width="491"
          height="524"
          loading="lazy"
          decoding="async"
        />
      </a>
      <p>{contacts.tagline}</p>
    </div>
    <div class="footer-column">
      <p class="footer-label">Посмотреть</p>
      <a href="/catalog">Каталог</a>
      <a href="/#about">О салоне</a>
      <a href="/contacts">Контакты</a>
    </div>
    <div class="footer-column">
      <p class="footer-label">Связаться</p>
      <a href={contacts.phoneLink}>{contacts.phoneDisplay}</a>
      <SocialLinks className="footer-socials" label="Связаться с Well Art" />
    </div>
  </div>
  <div class="footer-bottom">
    <p>© {year} {contacts.name}</p>
    <a href="/privacy">Политика конфиденциальности</a>
  </div>
</footer>
