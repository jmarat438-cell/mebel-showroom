---
import { contacts } from '@/utils/links';

interface Props {
  className?: string;
  label?: string;
}

const { className = '', label = 'Well Art в социальных сетях' } = Astro.props;
const socialLinks = [
  { name: 'WhatsApp', href: contacts.whatsapp, icon: '/icons/whatsapp-logo.svg' },
  { name: 'Instagram', href: contacts.instagram, icon: '/icons/instagram-logo.svg' },
  { name: 'Telegram', href: contacts.telegram, icon: '/icons/telegram-logo.svg' },
];
---
<nav class:list={['social-links', className]} aria-label={label}>
  {socialLinks.map((social) => (
    <a class="social-link" href={social.href} target="_blank" rel="noreferrer" aria-label={social.name} title={social.name}>
      <span class="social-icon" style={`--social-icon: url("${social.icon}")`} aria-hidden="true"></span>
    </a>
  ))}
</nav>

<style>
  .social-links { display: flex; align-items: center; gap: 7px; }
  .social-link { display: grid; width: 38px; height: 38px; place-items: center; border: 1px solid color-mix(in oklch, currentColor, transparent 72%); border-radius: 50%; transition: background-color .2s var(--ease-out), border-color .2s var(--ease-out); }
  .social-link:hover { border-color: currentColor; background: color-mix(in oklch, currentColor, transparent 91%); }
  .social-icon { width: 18px; height: 18px; background: currentColor; mask: var(--social-icon) center / contain no-repeat; -webkit-mask: var(--social-icon) center / contain no-repeat; }
</style>
